# Board defaults for the Sonocotta Amped-ESP32, ESP32-S3 variant
# (ESP32-S3-WROOM-1-N8R8: 8MB flash, 8MB octal PSRAM, native USB).
# This file is tracked. The generated sdkconfig is not (see .gitignore).

CONFIG_IDF_TARGET="esp32s3"

# Build for speed: -O2. Decoders and networking benefit; flash is plentiful.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Dynamic frequency scaling: 240 MHz under load, 160 MHz at idle
# (esp_pm_configure in brimbelle_main.c).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PM_ENABLE=y

# 8MB flash, DIO (the mode Sonocotta ships), custom partition table. QIO was
# tried on the bench (2026-11-10): it boots, with no measured gain, so DIO stays.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The board has no USB-UART bridge: the console is the ESP32-S3 USB Serial/JTAG
# peripheral (GPIO19/20), which esptool also flashes through.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# OTA rollback: a freshly updated image boots as "pending verify" and must mark
# itself healthy (app_main starts a task that does so after a stable uptime).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 8MB octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# More lwip sockets: config httpd + captive DNS + Sendspin WS + mDNS + the
# stream's HTTP client together exceed the default of 10.
CONFIG_LWIP_MAX_SOCKETS=16

# WebSocket post-handshake callback: the Sendspin server relies on it.
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# Internal RAM is the scarce resource: TLS, Wi-Fi/LWIP buffers and the big task
# stacks go to PSRAM (same tuning as Bugne, bench-proven there).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_WND_DEFAULT=8640

# No screen: a task stuck for 5 s must reboot the speaker (and
# leave a coredump), not just log a warning.
CONFIG_ESP_TASK_WDT_PANIC=y

# Coredumps to the flash partition, readable afterwards over GET /api/coredump.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=4
CONFIG_ESP_COREDUMP_LOGS=n
CONFIG_ESP_COREDUMP_STACK_SIZE=1792

# Radio hosts behind Google Trust Services need cross-signed verify.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
